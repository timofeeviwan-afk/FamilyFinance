<Window x:Class="FamilyFinance.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Width="380" Height="180"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Введите пароль" FontSize="14" Margin="0,0,0,12"/>
        <PasswordBox x:Name="Pwd" Margin="0,0,0,12"/>
        <Button Content="Войти" Click="OnLogin" Height="32" IsDefault="True"/>
    </StackPanel>
</Window>