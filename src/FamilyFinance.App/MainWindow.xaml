<Window x:Class="FamilyFinance.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Finance" Width="1100" Height="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Добавить" Click="OnAdd" Padding="8,2"/>
                <Button Content="Импорт PDF" Click="OnImport" Padding="8,2"/>
                <Separator/>
                <Button Content="Отчёт" Click="OnReport" Padding="8,2"/>
                <Button Content="Бэкап" Click="OnBackup" Padding="8,2"/>
                <Button Content="Отладка PDF" Click="OnDebugPdf" Padding="8,2"/>
            </ToolBar>
        </ToolBarTray>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Валюта" Binding="{Binding Currency}" Width="70"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="160"/>
                <DataGridTextColumn Header="Контрагент" Binding="{Binding Counterparty}" Width="200"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Готово"/></StatusBarItem>
        </StatusBar>
    </DockPanel>
</Window>
