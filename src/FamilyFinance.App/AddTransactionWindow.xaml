<Window x:Class="FamilyFinance.App.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая операция" Width="440" Height="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата:" Margin="0,6"/>
        <DatePicker x:Name="Dp" Grid.Row="0" Grid.Column="1" Margin="0,6"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Сумма:" Margin="0,6"/>
        <TextBox x:Name="TbAmount" Grid.Row="1" Grid.Column="1" Margin="0,6"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Счёт:" Margin="0,6"/>
        <ComboBox x:Name="CbAccount" Grid.Row="2" Grid.Column="1" Margin="0,6"
                  DisplayMemberPath="Name"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория:" Margin="0,6"/>
        <ComboBox x:Name="CbCategory" Grid.Row="3" Grid.Column="1" Margin="0,6"
                  DisplayMemberPath="Name"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Контрагент:" Margin="0,6"/>
        <TextBox x:Name="TbCounterparty" Grid.Row="4" Grid.Column="1" Margin="0,6"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Описание:" Margin="0,6"/>
        <TextBox x:Name="TbDescription" Grid.Row="5" Grid.Column="1" Margin="0,6"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" Width="100" Click="OnSave" IsDefault="True"/>
            <Button Content="Отмена" Width="100" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>