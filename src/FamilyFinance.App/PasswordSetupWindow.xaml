<Window x:Class="FamilyFinance.App.PasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание пароля" Width="380" Height="260"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Придумайте пароль для приложения"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,16"/>
        <TextBlock Text="Пароль:"/>
        <PasswordBox x:Name="Pwd1" Margin="0,4,0,12"/>
        <TextBlock Text="Повторите пароль:"/>
        <PasswordBox x:Name="Pwd2" Margin="0,4,0,12"/>
        <Button Content="Создать" Click="OnCreate" Height="32" IsDefault="True"/>
    </StackPanel>
</Window>